#!/bin/bash
# 煤矿排水设备故障风险预警平台 —— macOS 源码版启动脚本
# 双击本文件即可启动，浏览器会自动打开 http://127.0.0.1:8770
cd "$(dirname "$0")"

PY="./.venv/bin/python"
[ -x "$PY" ] || PY="python3"

echo "=============================================="
echo " 煤矿排水设备故障风险预警平台（源码版）"
echo " 使用解释器：$PY"
echo " 按 Ctrl+C 停止服务"
echo "=============================================="

exec "$PY" dashboard.py --port 8770
